{
  "manifest_version": 3,
  "name": "Salesforce Bulk File Downloader",
  "description": "Adds a native-looking Download All button to Salesforce Files related lists.",
  "version": "0.4.2",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.lightning.force.com/*",
    "https://*.my.salesforce.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.force.com/*",
        "https://*.lightning.force.com/*",
        "https://*.my.salesforce.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/options.html",
  "action": {
    "default_title": "Salesforce Bulk File Downloader",
    "default_popup": "src/popup/popup.html"
  }
}